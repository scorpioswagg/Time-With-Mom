# ===========================================
# Time With Mom – Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# Never commit real keys to git.

# ---------- Supabase ----------
# Create a free project at https://supabase.com
# Go to Project Settings → API Keys
#
# NEXT_PUBLIC_SUPABASE_URL          → Project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY     → Publishable key (sb_publishable_...)  OR  legacy anon key (eyJ...)
# SUPABASE_SERVICE_ROLE_KEY         → Secret key (sb_secret_...)            OR  legacy service_role key (eyJ...)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ---------- Daily.co ----------
# Sign up at https://dashboard.daily.co
# Dashboard → Developers → copy the API key
DAILY_API_KEY=your-daily-api-key
