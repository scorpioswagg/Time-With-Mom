# ===========================================
# Time With Mom – Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# Never commit real keys to git.

# ---------- Supabase ----------
# Create a free project at https://supabase.com
# Then go to Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings → API → service_role)
# Needed for creating rooms & messages from API routes.
# Keep this secret – never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Daily.co ----------
# Sign up at https://www.daily.co (free tier is generous)
# Dashboard → Developers → API keys
DAILY_API_KEY=your-daily-api-key

# Optional: if you have a custom Daily domain
# NEXT_PUBLIC_DAILY_DOMAIN=yourdomain.daily.co
